<Window x:Class="GeoCoordTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GeoCoordTool - 坐标处理工具" Width="1200" Height="760" WindowStartupLocation="CenterScreen" Background="#0B1324">
    <Window.Resources>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0"/>
            <GradientStop Color="#22FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4478FF"/>
            <Setter Property="BorderBrush" Value="#88FFFFFF"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="投影坐标保留位数" Foreground="White"/>
                    <TextBox Margin="0,6,8,0" Text="{Binding ProjectionDigits}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="经纬度保留位数" Foreground="White"/>
                    <TextBox Margin="0,6,8,0" Text="{Binding GeoDigits}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="输入路径" Foreground="White"/>
                    <TextBox Margin="0,6,8,0" Text="{Binding InputPath}"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="输出路径" Foreground="White"/>
                    <TextBox Margin="0,6,8,0" Text="{Binding OutputPath}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="读取 Excel" Command="{Binding LoadExcelCommand}"/>
                <Button Content="处理数据" Command="{Binding ProcessCommand}"/>
                <Button Content="导出结果" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Foreground="White" FontSize="14" TextWrapping="Wrap" Text="{Binding BoundsText}" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="1" Foreground="White" FontSize="14" TextWrapping="Wrap" Text="{Binding CenterText}" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="2" Foreground="White" FontSize="14" TextWrapping="Wrap" Text="{Binding MapSheetText}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="3">
                    <TextBlock Foreground="#D3E3FF" Text="标准格式预览" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding StandardPreview}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="250" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#B8D3FF"/>
    </Grid>
</Window>
